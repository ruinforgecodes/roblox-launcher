{
  "name": "ruinforge-roblox-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "RuinForge — a Windows launcher for Roblox experiences",
  "main": "src/main.cjs",
  "author": "RuinForge",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prestart": "node scripts/write-config.cjs",
    "build": "node scripts/write-config.cjs && electron-builder --win nsis --x64",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "43.8.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.ruinforge.launcher",
    "productName": "RuinForge Launcher",
    "asar": true,
    "directories": {
      "output": "release-build",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/ruinforge.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "RuinForge-Launcher-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RuinForge Launcher"
    }
  }
}
