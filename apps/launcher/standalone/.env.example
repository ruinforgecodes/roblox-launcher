# Roblox OAuth 2.0 application used by the Windows build.
# Create it at https://create.roblox.com/dashboard/credentials (OAuth 2.0 apps).
# Register this exact redirect URI: http://127.0.0.1:53682/oauth/callback
RUINFORGE_ROBLOX_CLIENT_ID=
# Optional: only if your Roblox OAuth app is a confidential client.
# Never commit this value.
RUINFORGE_ROBLOX_CLIENT_SECRET=
